# HIRNAO — Sandbox OVH (copier vers .env.sandbox sur le serveur)

# ─── Domaine ───────────────────────────────────────────────────────────
# Sous-domaine pointant vers l'IP du VPS OVH (ex: api-hirnao.beemm.io)
SANDBOX_DOMAIN=api-hirnao.example.com
ACME_EMAIL=samy@beemm.io

# URL du frontend Cloudflare Pages (pour liens QR organisateur)
WEB_URL=https://hirnao-demo.pages.dev

# ─── API ───────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Mode démo = données en mémoire, pas de Firebase (idéal sandbox rapide)
DEMO_MODE=true

# Pour prod sandbox avec Firebase :
# DEMO_MODE=false
# DB_BACKEND=firebase
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── CORS (origines frontend autorisées, séparées par des virgules) ────
CORS_ORIGINS=https://hirnao-demo.pages.dev,https://guic91.github.io

# ─── OpenAI (optionnel — agent LLM + embeddings) ───────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
