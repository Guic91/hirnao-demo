# Variables pour Coolify (docker-compose.prod.yml)
# Coolify → Environment → copier ces clés

# ─── Harbor (image registry) ───────────────────────────────────────────────
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=hirnao

# ─── App ───────────────────────────────────────────────────────────────────
WEB_URL=https://hirnao-demo.pages.dev
JWT_SECRET=change-me-openssl-rand-hex-32
DEMO_MODE=false

DATABASE_URL=postgresql://hirnao:CHANGE_ME@postgres:5432/hirnao
REDIS_URL=redis://redis:6379

POSTGRES_USER=hirnao
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hirnao

CORS_ORIGINS=https://hirnao-demo.pages.dev

# ─── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
