# Variables pour Coolify (docker-compose.prod.yml)
# Coolify → Environment → copier ces clés

# ─── Harbor (image registry) ───────────────────────────────────────────
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=hirnao

# ─── App ───────────────────────────────────────────────────────────────
WEB_URL=https://hirnao-demo.pages.dev
JWT_SECRET=change-me-openssl-rand-hex-32
DEMO_MODE=false
DB_BACKEND=firebase

CORS_ORIGINS=https://hirnao-demo.pages.dev

# ─── Firebase (Firestore) ──────────────────────────────────────────────
# Console Firebase → Paramètres projet → Comptes de service → Générer une clé
FIREBASE_PROJECT_ID=your-project-id
# Coller le JSON du compte de service sur une seule ligne :
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
